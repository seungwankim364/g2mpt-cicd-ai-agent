{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIRecommendation",
  "type": "object",
  "required": ["deploymentId", "summary", "severity", "causeCandidates", "recommendedAction", "nextSteps", "slackMessage"],
  "properties": {
    "deploymentId": { "type": "string" },
    "summary": { "type": "string" },
    "severity": { "type": "string" },
    "causeCandidates": {
      "type": "array",
      "items": { "type": "object" }
    },
    "recommendedAction": {
      "type": "object",
      "required": ["type", "reason", "requiresApproval"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "rollback",
            "dr",
            "restart_deployment",
            "scale_replicas",
            "increase_memory",
            "increase_hpa",
            "open_fix_issue",
            "open_change_pr",
            "observe"
          ]
        },
        "reason": { "type": "string" },
        "requiresApproval": { "const": true }
      }
    },
    "nextSteps": {
      "type": "array",
      "items": { "type": "string" }
    },
    "slackMessage": { "type": "object" }
  }
}
