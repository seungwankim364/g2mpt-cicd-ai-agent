{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AthenaSummary",
  "type": "object",
  "required": ["deploymentId", "service", "environment", "analysisWindow", "signals", "queryResults"],
  "properties": {
    "deploymentId": { "type": "string" },
    "service": { "type": "string" },
    "environment": { "type": "string" },
    "failedAt": { "type": "string" },
    "analysisWindow": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string" },
        "end": { "type": "string" }
      }
    },
    "signals": {
      "type": "array",
      "items": { "type": "object" }
    },
    "queryResults": {
      "type": "array",
      "items": { "type": "object" }
    }
  }
}

